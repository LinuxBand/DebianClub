# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/)

# Baseline browser safety headers for the static export
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Content-hashed bundles — cache forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Per-locale static search indexes (JSON without extension) — set type + moderate cache
/api/search/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

# AI-readable registry and docs indexes
/skills.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Generated OG images
/og/docs/*
  Cache-Control: public, max-age=86400

# Illustrations and partner logos
/images/*
  Cache-Control: public, max-age=86400
/assets/*
  Cache-Control: public, max-age=86400
